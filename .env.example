# -------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS (NEON / SUPABASE / HOSTINGER)
# -------------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@ep-cool-db.us-east-2.aws.neon.tech/anida_db?sslmode=require"

# -------------------------------------------------------------
# PASARELA 1: STRIPE (Tarjetas Crédito / Débito)
# -------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_sample_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_sample_webhook_secret"

# -------------------------------------------------------------
# PASARELA 2: MERCADO PAGO & SPEI (México / LATAM)
# -------------------------------------------------------------
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"
MERCADO_PAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MERCADO_PAGO_WEBHOOK_SECRET="sample_mercadopago_webhook_secret"

# -------------------------------------------------------------
# PASARELA 3: PAYPAL (Smart Payment Buttons)
# -------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sample_paypal_client_id"
PAYPAL_CLIENT_SECRET="sample_paypal_client_secret"

# -------------------------------------------------------------
# CONFIGURACIÓN DE LA APLICACIÓN
# -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://anida.store"
NEXTAUTH_SECRET="sample_anida_nextauth_secret_key_2026"
